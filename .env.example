# ── .env.example ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values marked ← EDIT.
# Never commit .env or service_account.json to version control.

# Google Drive folder ID — last segment of the folder URL:
# https://drive.google.com/drive/folders/THIS_PART
FOLDER_ID=PASTE_YOUR_FOLDER_ID_HERE                    # ← EDIT

# Public URL of this server — no trailing slash.
# Local:  http://192.168.1.x:5001
# Cloud:  http://YOUR_VM_PUBLIC_IP:5001
SERVER_BASE_URL=http://YOUR_SERVER_IP:5001             # ← EDIT

# How often (seconds) the server re-polls Google Drive for new images.
# 1800 = 30 min. Increase to reduce Drive API calls.
REFRESH_SECONDS=1800

# How often (seconds) to rotate to the next image across all frames.
# 600 = 10 min.
ROTATION_SECONDS=600

# Maximum number of images to load from Drive (sliding window of most recent).
POOL_SIZE=20

# Path to service_account.json — overridden to /app/service_account.json
# by docker-compose.yml. Only change this if running outside Docker.
CREDS_FILE=./service_account.json

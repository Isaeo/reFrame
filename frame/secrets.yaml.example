# Copy this file to secrets.yaml (same folder) and fill in your values.
# secrets.yaml is gitignored — never commit it.

wifi_ssid: "Your 2.4GHz Network Name"
wifi_password: "your-wifi-password"

# Fallback hotspot password (shown if the device can't reach Wi-Fi)
ap_password: "fallback-password"

# Generate a random 32-byte base64 key:  openssl rand -base64 32
api_encryption_key: "GENERATE_AND_PASTE_HERE"

# Any password you like — used to authorise OTA firmware updates
ota_password: "your-ota-password"
